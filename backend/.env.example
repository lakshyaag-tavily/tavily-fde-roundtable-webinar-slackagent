# Model calls use ChatOpenAI (gpt) and ChatNebius (kimi, nemotron) directly.
OPENAI_API_KEY=sk-...
NEBIUS_API_KEY=...

# Tavily powers the only two agent tools: search and extract.
TAVILY_API_KEY=tvly-...

# Slack app credentials from api.slack.com.
TAVILY_SCOUT_SLACK_BOT_TOKEN=xoxb-...
TAVILY_SCOUT_SLACK_SIGNING_SECRET=...

# Optional; discovered via auth.test when omitted.
# TAVILY_SCOUT_SLACK_BOT_USER_ID=U...
# TAVILY_SCOUT_SLACK_BOT_ID=B...

# Stream Tavily tool calls into a live Slack plan message.
TAVILY_SCOUT_SLACK_STREAM_TOOLS=true
# TAVILY_SCOUT_RUN_TIMEOUT_SECONDS=600
# TAVILY_SCOUT_RECURSION_LIMIT=100
# TAVILY_SCOUT_MAX_MODEL_CALLS=30
# TAVILY_SCOUT_MAX_TOOL_CALLS=30
# TAVILY_SCOUT_LOG_LEVEL=INFO

# Optional LangSmith tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=tavily-scout-slack-agent
