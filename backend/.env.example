# Model calls use ChatOpenAI (gpt) and ChatNebius (kimi, nemotron) directly.
OPENAI_API_KEY=sk-...
NEBIUS_API_KEY=...

# Tavily powers the only two agent tools: search and extract.
TAVILY_API_KEY=tvly-...

# Slack app credentials from api.slack.com.
ROUNDTABLE_AGENT_SLACK_BOT_TOKEN=xoxb-...
ROUNDTABLE_AGENT_SLACK_SIGNING_SECRET=...

# Optional; discovered via auth.test when omitted.
# ROUNDTABLE_AGENT_SLACK_BOT_USER_ID=U...
# ROUNDTABLE_AGENT_SLACK_BOT_ID=B...

# Stream Tavily tool calls into a live Slack plan message.
ROUNDTABLE_AGENT_SLACK_STREAM_TOOLS=true
# ROUNDTABLE_AGENT_RUN_TIMEOUT_SECONDS=600
# ROUNDTABLE_AGENT_RECURSION_LIMIT=100
# ROUNDTABLE_AGENT_MAX_MODEL_CALLS=30
# ROUNDTABLE_AGENT_MAX_TOOL_CALLS=30
# ROUNDTABLE_AGENT_LOG_LEVEL=INFO

# Optional LangSmith tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=tavily-scout-slack-agent
